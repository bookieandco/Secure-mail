# MAIL-1 isolated configuration. No secrets belong in this file.
# Copy to a local, untracked environment file only when local deployment is ready.

LOG_LEVEL=info
SUPERVISOR_LOGLEVEL=warn
ACCOUNT_PROVISIONER=FILE
PERMIT_DOCKER=none
ENABLE_UPDATE_CHECK=0

# Mail protocols
ENABLE_IMAP=1
ENABLE_POP3=0

# Security services
ENABLE_RSPAMD=1
ENABLE_CLAMAV=1
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=0
ENABLE_FAIL2BAN=0

# Authentication / sender controls
SPOOF_PROTECTION=1

# Local-only TLS for MAIL-1 testing. Production certificates are MAIL-3.
SSL_TYPE=self-signed
TLS_LEVEL=modern

# Keep DMS from trusting Docker-connected networks as authenticated senders.
PERMIT_DOCKER=none

# MAIL-1 does not publish management interfaces or data services.
